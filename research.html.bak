            <div align="center" style="border:1px black solid; border-top:0; border-collapse:collapse; width:70%;">
              <input type="button" style="width:28px; font-size:11px; text-align: center" onclick="if(document.ff.slide.selectedIndex==0) document.ff.fa.value='Replay'; else if(document.ff.slide.selectedIndex==1) document.ff.fa.value='Play'; else document.ff.fa.value='Resume'; rotate(x-1);" value="&lt;&lt;" title="Prev" />
              <input type="button" style="width:54px; font-size:11px; text-align: center" name="fa" onClick="if(this.value=='Replay') document.ff.slide.selectedIndex=1; this.value=((this.value=='Pause')?'Resume':'Pause');auto();" value="Play" title="Autoplay" style="width:75px;" />
              <input type="button" style="width:28px; font-size:11px; text-align: center" onclick="if(document.ff.slide.selectedIndex==39) document.ff.fa.value='Replay'; else if(document.ff.slide.selectedIndex==40) document.ff.fa.value='Play'; else document.ff.fa.value='Resume'; rotate(x+1);" value="&gt;&gt;" title="Next" />
